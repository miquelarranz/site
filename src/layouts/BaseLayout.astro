---
import BaseHead from '../components/BaseHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, ogImage, type, pubDate } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'writing' },
  { href: '/now', label: 'now' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
    />
  </head>
  <body style="display:flex;flex-direction:column;min-height:100dvh;padding-bottom:52px;">
    <a href="#main" class="skip-link">Skip to content</a>

    <header style="padding-block:1.75rem 0;">
      <div class="container" style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
        <a
          href="/"
          style="font-family:var(--font-serif);font-size:1rem;text-decoration:none;font-weight:400;color:var(--color-text);"
        >
          Miquel Arranz
        </a>
        <nav aria-label="Main navigation" style="display:flex;align-items:center;gap:1.5rem;">
          {navLinks.map(({ href, label }) => {
            const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class="mono"
                aria-current={isActive ? 'page' : undefined}
                style={`font-size:0.8125rem;text-decoration:none;color:${isActive ? 'var(--color-text)' : 'var(--color-muted)'};`}
              >
                {label}
              </a>
            );
          })}
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" style="flex:1;padding-block:2.5rem 3rem;">
      <div class="container">
        <slot />
      </div>
    </main>

    <!-- Fixed footer -->
    <footer style="
      position:fixed;
      bottom:0;
      left:0;
      right:0;
      background:var(--color-bg);
      border-top:1px solid var(--color-rule);
      padding:0.875rem 0;
      z-index:10;
    ">
      <div class="container">
        <span class="mono" style="color:var(--color-muted);font-size:0.75rem;">
          © {new Date().getFullYear()} Miquel Arranz
        </span>
      </div>
    </footer>
  </body>
</html>
