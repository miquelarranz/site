---
interface Props {
  date: Date;
  format?: 'short' | 'long';
}

const { date, format = 'short' } = Astro.props;

const year = date.getFullYear();
const dayMonth = date.toLocaleDateString('en-GB', { month: 'short', day: 'numeric' });

const formatted = format === 'short'
  ? `${year} – ${dayMonth}`
  : date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });

const iso = date.toISOString();
---

<time datetime={iso} class="mono" style="color:var(--color-muted)">{formatted}</time>
